{
  "activationEvents": [
    "onView:signboardDuo.board",
    "onCommand:signboardDuo.showLed",
    "onCommand:signboardDuo.showFlap",
    "onCommand:signboardDuo.setToken",
    "onCommand:signboardDuo.deleteToken",
    "onCommand:signboardDuo.refresh",
    "onCommand:signboardDuo.prevPlatform",
    "onCommand:signboardDuo.nextPlatform",
    "onCommand:signboardDuo.pinPlatform",
    "onCommand:signboardDuo.unpinPlatform",
    "onCommand:signboardDuo.cycleTheme",
    "onCommand:signboardDuo.showStock",
    "onCommand:signboardDuo.cycleMode",
    "onCommand:signboardDuo.cycleModeFlap",
    "onCommand:signboardDuo.cycleModeLed",
    "onCommand:signboardDuo.cycleModeStock"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "signboardDuo.showLed",
        "icon": "$(dashboard)",
        "title": "%command.showLed.title%"
      },
      {
        "command": "signboardDuo.showFlap",
        "icon": {
          "dark": "media/flight-dark.svg",
          "light": "media/flight-light.svg"
        },
        "title": "%command.showFlap.title%"
      },
      {
        "command": "signboardDuo.setToken",
        "title": "%command.setToken.title%"
      },
      {
        "command": "signboardDuo.deleteToken",
        "title": "%command.deleteToken.title%"
      },
      {
        "command": "signboardDuo.refresh",
        "icon": "$(refresh)",
        "title": "%command.refresh.title%"
      },
      {
        "command": "signboardDuo.prevPlatform",
        "icon": "$(chevron-left)",
        "title": "%command.prevPlatform.title%"
      },
      {
        "command": "signboardDuo.nextPlatform",
        "icon": "$(chevron-right)",
        "title": "%command.nextPlatform.title%"
      },
      {
        "command": "signboardDuo.pinPlatform",
        "icon": "$(pin)",
        "title": "%command.pinPlatform.title%"
      },
      {
        "command": "signboardDuo.unpinPlatform",
        "icon": "$(pinned)",
        "title": "%command.unpinPlatform.title%"
      },
      {
        "command": "signboardDuo.cycleTheme",
        "title": "%command.cycleTheme.title%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "signboardDuo.showStock",
        "title": "%command.showStock.title%",
        "icon": "$(graph-line)"
      },
      {
        "command": "signboardDuo.cycleMode",
        "title": "%command.cycleMode.title%",
        "icon": "$(layout)"
      },
      {
        "command": "signboardDuo.cycleModeFlap",
        "title": "%command.cycleModeFlap.title%",
        "icon": {
          "dark": "media/flight-dark.svg",
          "light": "media/flight-light.svg"
        }
      },
      {
        "command": "signboardDuo.cycleModeLed",
        "title": "%command.cycleModeLed.title%",
        "icon": "$(dashboard)"
      },
      {
        "command": "signboardDuo.cycleModeStock",
        "title": "%command.cycleModeStock.title%",
        "icon": "$(graph-line)"
      }
    ],
    "configuration": {
      "properties": {
        "signboardDuo.feeds": {
          "default": [],
          "items": {
            "properties": {
              "auth": {
                "description": "%config.feeds.auth.description%",
                "properties": {
                  "headerName": {
                    "description": "Header name for header auth (e.g. X-API-Key).",
                    "type": "string"
                  },
                  "type": {
                    "default": "none",
                    "enum": [
                      "none",
                      "bearer",
                      "basic",
                      "header"
                    ],
                    "type": "string"
                  },
                  "user": {
                    "description": "User name for basic auth.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "enabled": {
                "default": true,
                "description": "%config.feeds.enabled.description%",
                "type": "boolean"
              },
              "id": {
                "description": "%config.feeds.id.description%",
                "pattern": "^[a-z0-9-]+$",
                "type": "string"
              },
              "keepHours": {
                "default": 24,
                "description": "%config.feeds.keepHours.description%",
                "maximum": 168,
                "minimum": 1,
                "type": "number"
              },
              "kind": {
                "default": "generic",
                "description": "%config.feeds.kind.description%",
                "enum": [
                  "generic",
                  "ci",
                  "status",
                  "jma",
                  "stock"
                ],
                "type": "string",
                "enumDescriptions": [
                  "%config.feeds.kind.generic%",
                  "%config.feeds.kind.ci%",
                  "%config.feeds.kind.status%",
                  "%config.feeds.kind.jma%",
                  "%config.feeds.kind.stock%"
                ]
              },
              "maxItems": {
                "default": 4,
                "description": "%config.feeds.maxItems.description%",
                "maximum": 20,
                "minimum": 1,
                "type": "number"
              },
              "name": {
                "description": "%config.feeds.name.description%",
                "type": "string"
              },
              "url": {
                "description": "%config.feeds.url.description%",
                "type": "string"
              }
            },
            "required": [
              "id",
              "url"
            ],
            "type": "object"
          },
          "markdownDescription": "RSS / Atom feeds shown as platforms (max 20). Array order is the platform number.",
          "maxItems": 20,
          "type": "array",
          "description": "%config.feeds.description%"
        },
        "signboardDuo.ledGlow": {
          "default": true,
          "description": "%config.ledGlow.description%",
          "type": "boolean"
        },
        "signboardDuo.ledHole": {
          "default": 38,
          "description": "%config.ledHole.description%",
          "maximum": 70,
          "minimum": 10,
          "type": "number"
        },
        "signboardDuo.ledPitch": {
          "default": 3,
          "description": "%config.ledPitch.description%",
          "maximum": 8,
          "minimum": 2,
          "type": "number"
        },
        "signboardDuo.mode": {
          "default": "flap",
          "description": "%config.mode.description%",
          "enum": [
            "auto",
            "flap",
            "led",
            "stock"
          ],
          "type": "string",
          "enumDescriptions": [
            "%config.mode.auto%",
            "%config.mode.flap%",
            "%config.mode.led%",
            "%config.mode.stock%"
          ]
        },
        "signboardDuo.pollMinutes": {
          "default": 15,
          "description": "%config.pollMinutes.description%",
          "maximum": 180,
          "minimum": 5,
          "type": "number"
        },
        "signboardDuo.scrollLongText": {
          "default": true,
          "description": "%config.scrollLongText.description%",
          "type": "boolean"
        }
      },
      "title": "%config.title%"
    },
    "menus": {
      "view/title": [
        {
          "command": "signboardDuo.prevPlatform",
          "when": "view == signboardDuo.board",
          "group": "navigation@1"
        },
        {
          "command": "signboardDuo.pinPlatform",
          "when": "view == signboardDuo.board && !signboardDuo.pinned",
          "group": "navigation@2"
        },
        {
          "command": "signboardDuo.unpinPlatform",
          "when": "view == signboardDuo.board && signboardDuo.pinned",
          "group": "navigation@2"
        },
        {
          "command": "signboardDuo.nextPlatform",
          "when": "view == signboardDuo.board",
          "group": "navigation@3"
        },
        {
          "command": "signboardDuo.refresh",
          "when": "view == signboardDuo.board",
          "group": "navigation@4"
        },
        {
          "command": "signboardDuo.cycleTheme",
          "when": "view == signboardDuo.board",
          "group": "navigation@5"
        },
        {
          "command": "signboardDuo.cycleModeFlap",
          "when": "view == signboardDuo.board && signboardDuo.isFlap",
          "group": "navigation@6"
        },
        {
          "command": "signboardDuo.cycleModeLed",
          "when": "view == signboardDuo.board && signboardDuo.isLed",
          "group": "navigation@6"
        },
        {
          "command": "signboardDuo.cycleModeStock",
          "when": "view == signboardDuo.board && signboardDuo.isStock",
          "group": "navigation@6"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "signboardDuo.board",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    }
  },
  "description": "%extension.description%",
  "displayName": "Signboard-Duo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/Signboard-Duo.git"
  },
  "main": "./src/extension.js",
  "name": "signboard-duo",
  "publisher": "masanori-satake",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/model.js && node --check src/feedparse.js",
    "package": "vsce package",
    "test": "node --test",
    "check-version": "node scripts/check-version.js",
    "check-version-bump": "node scripts/check-version.js --check-bump"
  },
  "version": "1.3.7"
}
