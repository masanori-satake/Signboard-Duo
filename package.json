{
  "activationEvents": [
    "onView:signboardDuo.board",
    "onCommand:signboardDuo.showLed",
    "onCommand:signboardDuo.showFlap",
    "onCommand:signboardDuo.setToken",
    "onCommand:signboardDuo.deleteToken",
    "onCommand:signboardDuo.refresh",
    "onCommand:signboardDuo.prevPlatform",
    "onCommand:signboardDuo.nextPlatform",
    "onCommand:signboardDuo.pinPlatform",
    "onCommand:signboardDuo.unpinPlatform",
    "onCommand:signboardDuo.cycleTheme",
    "onCommand:signboardDuo.showStock",
    "onCommand:signboardDuo.cycleMode",
    "onCommand:signboardDuo.cycleModeFlap",
    "onCommand:signboardDuo.cycleModeLed",
    "onCommand:signboardDuo.cycleModeStock"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "signboardDuo.showLed",
        "icon": "$(dashboard)",
        "title": "Signboard-Duo: Show LED Board"
      },
      {
        "command": "signboardDuo.showFlap",
        "icon": {
          "dark": "media/flight-dark.svg",
          "light": "media/flight-light.svg"
        },
        "title": "Signboard-Duo: Show Flap Board"
      },
      {
        "command": "signboardDuo.setToken",
        "title": "Signboard-Duo: Set Feed Token"
      },
      {
        "command": "signboardDuo.deleteToken",
        "title": "Signboard-Duo: Delete Feed Token"
      },
      {
        "command": "signboardDuo.refresh",
        "icon": "$(refresh)",
        "title": "Signboard-Duo: Refresh Feeds Now"
      },
      {
        "command": "signboardDuo.prevPlatform",
        "icon": "$(chevron-left)",
        "title": "Signboard-Duo: Previous Platform"
      },
      {
        "command": "signboardDuo.nextPlatform",
        "icon": "$(chevron-right)",
        "title": "Signboard-Duo: Next Platform"
      },
      {
        "command": "signboardDuo.pinPlatform",
        "icon": "$(pin)",
        "title": "Signboard-Duo: Pin This Platform"
      },
      {
        "command": "signboardDuo.unpinPlatform",
        "icon": "$(pinned)",
        "title": "Signboard-Duo: Unpin Platform"
      },
      {
        "command": "signboardDuo.cycleTheme",
        "title": "Signboard-Duo: Switch Colour Theme",
        "icon": "$(symbol-color)"
      },
      {
        "command": "signboardDuo.showStock",
        "title": "Signboard-Duo: Show Stock Board",
        "icon": "$(graph-line)"
      },
      {
        "command": "signboardDuo.cycleMode",
        "title": "Signboard-Duo: Switch Board Style",
        "icon": "$(layout)"
      },
      {
        "command": "signboardDuo.cycleModeFlap",
        "title": "Signboard-Duo: Switch Board Style",
        "icon": {
          "dark": "media/flight-dark.svg",
          "light": "media/flight-light.svg"
        }
      },
      {
        "command": "signboardDuo.cycleModeLed",
        "title": "Signboard-Duo: Switch Board Style",
        "icon": "$(dashboard)"
      },
      {
        "command": "signboardDuo.cycleModeStock",
        "title": "Signboard-Duo: Switch Board Style",
        "icon": "$(graph-line)"
      }
    ],
    "configuration": {
      "properties": {
        "signboardDuo.feeds": {
          "default": [],
          "items": {
            "properties": {
              "auth": {
                "description": "Auth method only — the secret itself is stored via the Set Feed Token command, never in settings.",
                "properties": {
                  "headerName": {
                    "description": "Header name for header auth (e.g. X-API-Key).",
                    "type": "string"
                  },
                  "type": {
                    "default": "none",
                    "enum": [
                      "none",
                      "bearer",
                      "basic",
                      "header"
                    ],
                    "type": "string"
                  },
                  "user": {
                    "description": "User name for basic auth.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "enabled": {
                "default": true,
                "description": "Disabled feeds get no platform number.",
                "type": "boolean"
              },
              "id": {
                "description": "Stable feed id. Also keys the stored token.",
                "pattern": "^[a-z0-9-]+$",
                "type": "string"
              },
              "keepHours": {
                "default": 24,
                "description": "Hours a topic stays after it leaves the feed.",
                "maximum": 168,
                "minimum": 1,
                "type": "number"
              },
              "kind": {
                "default": "generic",
                "description": "How items are interpreted on the board.",
                "enum": [
                  "generic",
                  "bamboo",
                  "status",
                  "jma",
                  "stock"
                ],
                "type": "string"
              },
              "maxItems": {
                "default": 4,
                "description": "Max topics shown for this platform.",
                "maximum": 10,
                "minimum": 1,
                "type": "number"
              },
              "name": {
                "description": "Platform name on the board. Defaults to the feed title.",
                "type": "string"
              },
              "url": {
                "description": "Feed URL (http/https).",
                "type": "string"
              }
            },
            "required": [
              "id",
              "url"
            ],
            "type": "object"
          },
          "markdownDescription": "RSS / Atom feeds shown as platforms (max 5). Array order is the platform number.",
          "maxItems": 5,
          "type": "array"
        },
        "signboardDuo.ledGlow": {
          "default": true,
          "description": "LED glow (blurred copy under the mask).",
          "type": "boolean"
        },
        "signboardDuo.ledHole": {
          "default": 38,
          "description": "LED hole size in percent.",
          "maximum": 70,
          "minimum": 10,
          "type": "number"
        },
        "signboardDuo.ledPitch": {
          "default": 3,
          "description": "LED dot pitch in px.",
          "maximum": 8,
          "minimum": 2,
          "type": "number"
        },
        "signboardDuo.mode": {
          "default": "flap",
          "description": "Board style: split-flap, LED, or stock board. Auto uses flap below 540px and LED at 540px and wider.",
          "enum": [
            "auto",
            "flap",
            "led",
            "stock"
          ],
          "type": "string"
        },
        "signboardDuo.pollMinutes": {
          "default": 15,
          "description": "Feed polling interval in minutes.",
          "maximum": 180,
          "minimum": 5,
          "type": "number"
        },
        "signboardDuo.scrollLongText": {
          "default": true,
          "description": "Scroll (LED) or flip through (flap) long titles instead of truncating them.",
          "type": "boolean"
        }
      },
      "title": "Signboard-Duo"
    },
    "menus": {
      "view/title": [
        {
          "command": "signboardDuo.prevPlatform",
          "when": "view == signboardDuo.board",
          "group": "navigation@1"
        },
        {
          "command": "signboardDuo.pinPlatform",
          "when": "view == signboardDuo.board && !signboardDuo.pinned",
          "group": "navigation@2"
        },
        {
          "command": "signboardDuo.unpinPlatform",
          "when": "view == signboardDuo.board && signboardDuo.pinned",
          "group": "navigation@2"
        },
        {
          "command": "signboardDuo.nextPlatform",
          "when": "view == signboardDuo.board",
          "group": "navigation@3"
        },
        {
          "command": "signboardDuo.refresh",
          "when": "view == signboardDuo.board",
          "group": "navigation@4"
        },
        {
          "command": "signboardDuo.cycleTheme",
          "when": "view == signboardDuo.board",
          "group": "navigation@5"
        },
        {
          "command": "signboardDuo.cycleModeFlap",
          "when": "view == signboardDuo.board && signboardDuo.isFlap",
          "group": "navigation@6"
        },
        {
          "command": "signboardDuo.cycleModeLed",
          "when": "view == signboardDuo.board && signboardDuo.isLed",
          "group": "navigation@6"
        },
        {
          "command": "signboardDuo.cycleModeStock",
          "when": "view == signboardDuo.board && signboardDuo.isStock",
          "group": "navigation@6"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "signboardDuo.board",
          "name": "Signboard-Duo",
          "type": "webview"
        }
      ]
    }
  },
  "description": "A split-flap / LED board for your RSS & Atom feeds and CI results — topics arrive like trains and planes.",
  "displayName": "Signboard-Duo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "icon.png",
  "license": "MIT",
  "main": "./src/extension.js",
  "name": "signboard-duo",
  "publisher": "masanori-satake",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/model.js && node --check src/feedparse.js",
    "package": "vsce package",
    "test": "node --test"
  },
  "version": "0.7.5"
}
